      "link": null,
      "locked": false,
      "text": "Two silent-failure traps",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two silent-failure traps",
      "autoResize": false,
