      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Tables:\n1. accounts\n2. transactions + reversal_of_id\n3. postings\n4. balances\n5. outbox events + traceparent\n6. idempotency_records\n7. settlements\n8. holds\n\nLedger changes + idempotency results\n+ outbox event commit in one\nACID transaction",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tables:\n1. accounts\n2. transactions + reversal_of_id\n3. postings\n4. balances\n5. outbox events + traceparent\n6. idempotency_records\n7. settlements\n8. holds\n\nLedger changes + idempotency results\n+ outbox event commit in one\nACID transaction",
      "autoResize": false,
      "lineHeight": 1.25
    },
