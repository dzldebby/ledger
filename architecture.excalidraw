      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "A red test suite can never deploy. Checks out\nworkflow_run.head_sha - such jobs otherwise run\nagainst the tip of main, not the commit CI validated.\nAuth is a short-lived OIDC token: no AWS keys in\nGitHub secrets.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A red test suite can never deploy. Checks out\nworkflow_run.head_sha - such jobs otherwise run\nagainst the tip of main, not the commit CI validated.\nAuth is a short-lived OIDC token: no AWS keys in\nGitHub secrets.",
      "autoResize": false,
      "lineHeight": 1.25
    },
