    },
    {
      "id": "n6_b",
      "type": "text",
      "x": 1222,
      "y": 1034,
      "width": 426,
      "height": 136,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 297015553,
      "version": 1,
      "versionNonce": 1156179110,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "app/auth.py holds counters in process memory. At\nscale=1 this is exact. At scale=2 each replica counts\nindependently, so a client's effective limit becomes\nup to 2x the configured value.\n\nAccepted, not a bug here - a correct limiter needs\nshared state such as Redis.\n\nThe HLD calls for scale=2; this runs 1 to halve cost.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "app/auth.py holds counters in process memory. At\nscale=1 this is exact. At scale=2 each replica counts\nindependently, so a client's effective limit becomes\nup to 2x the configured value.\n\nAccepted, not a bug here - a correct limiter needs\nshared state such as Redis.\n\nThe HLD calls for scale=2; this runs 1 to halve cost.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "l4",
      "type": "rectangle",
      "x": 40,
      "y": 1250,
      "width": 1640,
      "height": 110,
      "angle": 0,
