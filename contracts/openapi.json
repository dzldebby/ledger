  "components": {
    "schemas": {
      "AccountCreate": {
        "properties": {
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "account_type": {
            "type": "string",
            "enum": [
              "cash",
              "personal",
              "customer",
              "business",
              "external_bank"
            ],
            "title": "Account Type"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "pattern": "^[A-Za-z]{3}$",
            "title": "Currency",
            "default": "USD"
          }
        },
        "type": "object",
        "required": [
          "owner_id",
          "account_type"
        ],
        "title": "AccountCreate"
      },
      "AccountHistoryResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/AccountTransaction"
            },
            "type": "array",
            "title": "Transactions"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "transactions",
          "count"
        ],
        "title": "AccountHistoryResponse"
      },
      "AccountPosting": {
        "properties": {
          "side": {
            "type": "string",
            "title": "Side"
          },
          "amount_minor": {
            "type": "integer",
            "title": "Amount Minor"
          }
        },
        "type": "object",
        "required": [
          "side",
          "amount_minor"
        ],
        "title": "AccountPosting"
      },
      "AccountResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "owner_id": {
            "type": "string",
            "title": "Owner Id"
          },
          "account_type": {
            "type": "string",
            "title": "Account Type"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "owner_id",
          "account_type",
          "currency",
          "status"
        ],
        "title": "AccountResponse"
      },
      "AccountTransaction": {
        "properties": {
          "transaction_id": {
            "type": "string",
            "title": "Transaction Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "reversal_of_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reversal Of Id"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time",
            "title": "Recorded At"
          },
          "posting": {
            "$ref": "#/components/schemas/AccountPosting"
          }
        },
        "type": "object",
        "required": [
          "transaction_id",
          "type",
          "state",
          "reversal_of_id",
          "recorded_at",
          "posting"
        ],
        "title": "AccountTransaction"
      },
      "BalanceResponse": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "balance_minor": {
            "type": "integer",
            "title": "Balance Minor"
          },
          "available_balance_minor": {
            "type": "integer",
            "title": "Available Balance Minor"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "balance_minor",
          "available_balance_minor"
        ],
        "title": "BalanceResponse"
      },
      "DepositCreate": {
        "properties": {
          "account_id": {
            "type": "string",
            "title": "Account Id"
          },
          "cash_account_id": {
            "type": "string",
            "title": "Cash Account Id"
          },
          "amount_minor": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Amount Minor"
          }
        },
        "type": "object",
        "required": [
          "account_id",
          "cash_account_id",
          "amount_minor"
        ],
        "title": "DepositCreate"
      },
      "EventFeedPage": {
        "properties": {
          "events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Events"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "events",
          "count"
        ],
        "title": "EventFeedPage",
        "description": "One page of the event feed.\n\n`events` is deliberately untyped. Its shape is the envelope defined in\ncontracts/events/README.md, and restating it as a Pydantic model here\nwould create a second definition that can silently drift from the\ncontract, the fixtures and the contract test. There is one definition and\nit lives in app/services/events.py."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OutboxStats": {
        "properties": {
          "total_events": {
            "type": "integer",
            "title": "Total Events"
          },
          "unpublished_events": {
            "type": "integer",
            "title": "Unpublished Events"
          },
          "events_by_type": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Events By Type"
          },
          "newest_event_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Newest Event At"
          }
        },
        "type": "object",
        "required": [
          "total_events",
          "unpublished_events",
          "events_by_type"
        ],
