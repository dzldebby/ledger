        "/admin/outbox/stats": {
            "get": {
                "tags": [
                    "admin"
                ],
                "summary": "Outbox Stats Endpoint",
                "description": "Aggregate outbox counts, for checking the outbox in a deployment where\nthe database cannot be reached directly.",
                "operationId": "outbox_stats_endpoint_admin_outbox_stats_get",
                "parameters": [
                    {
                        "name": "X-API-Key",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "title": "X-Api-Key"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/OutboxStats"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "summary": "Health",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {}
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AccountCreate": {
                "properties": {
                    "owner_id": {
                        "type": "string",
                        "title": "Owner Id"
                    },
                    "account_type": {
                        "type": "string",
                        "title": "Account Type"
                    }
                },
                "type": "object",
                "required": [
                    "owner_id",
                    "account_type"
                ],
                "title": "AccountCreate"
            },
            "AccountResponse": {
                "properties": {
                    "account_id": {
                        "type": "string",
                        "title": "Account Id"
                    },
                    "owner_id": {
                        "type": "string",
                        "title": "Owner Id"
                    },
                    "account_type": {
                        "type": "string",
                        "title": "Account Type"
                    },
                    "status": {
                        "type": "string",
                        "title": "Status"
                    }
                },
                "type": "object",
                "required": [
                    "account_id",
                    "owner_id",
                    "account_type",
                    "status"
                ],
                "title": "AccountResponse"
            },
            "BalanceResponse": {
                "properties": {
                    "account_id": {
                        "type": "string",
                        "title": "Account Id"
                    },
                    "balance_minor": {
                        "type": "integer",
                        "title": "Balance Minor"
                    }
                },
                "type": "object",
                "required": [
                    "account_id",
                    "balance_minor"
                ],
                "title": "BalanceResponse"
            },
            "DepositCreate": {
                "properties": {
                    "account_id": {
                        "type": "string",
                        "title": "Account Id"
                    },
                    "cash_account_id": {
                        "type": "string",
                        "title": "Cash Account Id"
                    },
                    "amount_minor": {
                        "type": "integer",
                        "exclusiveMinimum": 0.0,
                        "title": "Amount Minor"
                    }
                },
                "type": "object",
                "required": [
                    "account_id",
                    "cash_account_id",
                    "amount_minor"
                ],
                "title": "DepositCreate"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "OutboxStats": {
                "properties": {
                    "total_events": {
                        "type": "integer",
                        "title": "Total Events"
                    },
                    "unpublished_events": {
                        "type": "integer",
                        "title": "Unpublished Events"
                    },
                    "events_by_type": {
                        "additionalProperties": {
                            "type": "integer"
                        },
                        "type": "object",
                        "title": "Events By Type"
                    },
                    "newest_event_at": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Newest Event At"
                    }
                },
                "type": "object",
                "required": [
                    "total_events",
                    "unpublished_events",
                    "events_by_type"
                ],
                "title": "OutboxStats"
            },
            "PostingResponse": {
                "properties": {
                    "account_id": {
                        "type": "string",
                        "title": "Account Id"
                    },
                    "side": {
                        "type": "string",
                        "title": "Side"
                    },
                    "amount_minor": {
                        "type": "integer",
                        "title": "Amount Minor"
                    }
                },
                "type": "object",
                "required": [
                    "account_id",
                    "side",
                    "amount_minor"
                ],
                "title": "PostingResponse"
            },
            "TransactionResponse": {
                "properties": {
                    "transaction_id": {
                        "type": "string",
                        "title": "Transaction Id"
                    },
                    "type": {
                        "type": "string",
                        "title": "Type"
                    },
                    "state": {
                        "type": "string",
                        "title": "State"
                    },
                    "postings": {
                        "items": {
                            "$ref": "#/components/schemas/PostingResponse"
                        },
                        "type": "array",
                        "title": "Postings"
                    },
                    "reversal_of_id": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Reversal Of Id"
                    }
                },
                "type": "object",
                "required": [
                    "transaction_id",
                    "type",
                    "state",
                    "postings"
                ],
                "title": "TransactionResponse"
            },
            "TransferCreate": {
                "properties": {
                    "from_account_id": {
                        "type": "string",
                        "title": "From Account Id"
                    },
                    "to_account_id": {
                        "type": "string",
                        "title": "To Account Id"
                    },
                    "amount_minor": {
                        "type": "integer",
                        "exclusiveMinimum": 0.0,
                        "title": "Amount Minor"
                    }
                },
                "type": "object",
                "required": [
                    "from_account_id",
                    "to_account_id",
                    "amount_minor"
                ],
                "title": "TransferCreate"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
