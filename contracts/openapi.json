    "/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Event Feed",
        "description": "Pull-based feed of ledger events, oldest first.\n\nAn alternative to consuming from the message broker, for consumers that\ncannot reach it. Same envelope, same at-least-once expectations: keep\ndeduplicating on `event_id`, because a consumer that crashes after\nprocessing but before storing `next_cursor` will re-read the page.\n\nStore `next_cursor` and send it back to continue. The ledger keeps no\nper-consumer state, so consumers cannot interfere with each other and a\nnew one can start from the beginning at any time.\n\nAn empty `events` list means you are caught up; poll again later with the\nsame cursor.",
        "operationId": "event_feed_events_get",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque cursor from a previous response's next_cursor. Omit to start from the beginning of the feed.",
              "title": "Cursor"
            },
            "description": "Opaque cursor from a previous response's next_cursor. Omit to start from the beginning of the feed."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          },
          {
            "name": "X-API-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "title": "X-Api-Key"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventFeedPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
