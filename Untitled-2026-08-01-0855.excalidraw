    {
      "id": "uH6s8Q6hDff8-wxUqbCui",
      "type": "text",
      "x": -189.67349538639746,
      "y": -18.86929022525618,
      "width": 466.099365234375,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aUV",
